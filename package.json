    "playwright": "1.65.0",
    "three": "^0.187.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.4.6",
